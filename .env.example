LLM_PROVIDER=xai
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# Optional OpenAI fallback:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini

# Tiingo (preferred for US equities/ETFs incl. gold ETFs like GLD/IAU):
# TIINGO_API_KEY=your_tiingo_token_here

# VPS/container persistence:
# TRADING_RESEARCH_HOST_OUTPUT_DIR=./outputs
# TRADING_RESEARCH_OUTPUT_DIR=outputs
# TRADING_RESEARCH_CACHE_DIR=outputs/cache
# TRADING_RESEARCH_DISABLE_CACHE=0
MPLBACKEND=Agg
PYTHONUNBUFFERED=1
